PORT=3000

# Type de base de données: 'sqlite' (par défaut, aucun serveur requis) ou 'mysql'
DB_TYPE=sqlite

# MySQL (uniquement si DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=task_manager_db

# JWT
JWT_SECRET=votre_cle_secrete
JWT_EXPIRES_IN=1d

# API externe (OpenWeatherMap)
WEATHER_API_KEY=votre_cle_api
